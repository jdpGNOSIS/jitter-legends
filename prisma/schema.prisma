generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
}

model Player {
  id                String          @id @default(cuid())
  slug              String          @unique
  name              String
  ign               String
  age               Int
  country           String
  biography         String
  careerEarnings    Float           @default(0)
  mvpCount          Int             @default(0)
  tournamentWins    Int             @default(0)
  headshotPercentage Float          @default(0)
  kdRatio           Float           @default(0)
  rating            Float           @default(0)
  mapsPlayed        Int             @default(0)
  clutchesWon       Int             @default(0)
  signatureWeapon   String          @default("AK-47")
  pistolRoundWinRate Float          @default(0)
  totalKills        Int             @default(0)
  imageUrl          String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  teamHistory      PlayerTeam[]
  matchStats       PlayerMatchStat[]
  achievements     Achievement[]
  careerEvents     CareerEvent[]
  tournamentMvps   Tournament[]     @relation("TournamentMVP")
}

model Team {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  acronym       String
  description   String
  logoUrl       String?
  primaryColor  String        @default("#6366f1")
  secondaryColor String       @default("#06b6d4")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  players       PlayerTeam[]
  playerStats   PlayerMatchStat[]
  homeMatches   Match[]       @relation("HomeTeam")
  awayMatches   Match[]       @relation("AwayTeam")
  tournamentWins Tournament[] @relation("TournamentWinnerTeam")
}

model PlayerTeam {
  id        String    @id @default(cuid())
  playerId  String
  teamId    String
  startDate DateTime
  endDate   DateTime?
  role      String    @default("Player")

  player    Player    @relation(fields: [playerId], references: [id])
  team      Team      @relation(fields: [teamId], references: [id])
}

model Tournament {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  location    String
  startDate   DateTime
  endDate     DateTime
  prizePool   Float     @default(0)
  tier        String    @default("A")
  status      String    @default("completed")
  winnerId    String?
  mvpId       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  winner      Team?     @relation("TournamentWinnerTeam", fields: [winnerId], references: [id])
  mvp         Player?   @relation("TournamentMVP", fields: [mvpId], references: [id])
  matches     Match[]
}

model Match {
  id          String    @id @default(cuid())
  slug        String    @unique
  tournamentId String
  team1Id     String
  team2Id     String
  team1Score  Int       @default(0)
  team2Score  Int       @default(0)
  date        DateTime
  round       String    @default("Group Stage")
  status      String    @default("completed")
  winnerId    String?
  format      String    @default("bo3")

  tournament  Tournament @relation(fields: [tournamentId], references: [id])
  team1       Team      @relation("HomeTeam", fields: [team1Id], references: [id])
  team2       Team      @relation("AwayTeam", fields: [team2Id], references: [id])

  maps        MatchMap[]
  playerStats PlayerMatchStat[]
}

model MatchMap {
  id          String   @id @default(cuid())
  matchId     String
  mapName     String
  team1Score  Int      @default(0)
  team2Score  Int      @default(0)
  winnerId    String?

  match       Match    @relation(fields: [matchId], references: [id])
}

model PlayerMatchStat {
  id          String  @id @default(cuid())
  playerId    String
  matchId     String
  teamId      String
  kills       Int     @default(0)
  deaths      Int     @default(0)
  assists     Int     @default(0)
  headshots   Int     @default(0)
  adr         Float   @default(0)
  rating      Float   @default(0)
  kdDiff      Int     @default(0)
  clutchesWon Int     @default(0)

  player      Player  @relation(fields: [playerId], references: [id])
  match       Match   @relation(fields: [matchId], references: [id])
  team        Team    @relation(fields: [teamId], references: [id])
}

model NewsArticle {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  author      String    @default("JITTER LEGENDS Staff")
  imageUrl    String?
  publishedAt DateTime  @default(now())
  featured    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Achievement {
  id          String    @id @default(cuid())
  playerId    String
  name        String
  description String
  icon        String    @default("trophy")
  unlockedAt  DateTime  @default(now())

  player      Player    @relation(fields: [playerId], references: [id])
}

model CareerEvent {
  id          String    @id @default(cuid())
  playerId    String
  title       String
  description String
  date        DateTime
  type        String    @default("milestone")

  player      Player    @relation(fields: [playerId], references: [id])
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}
